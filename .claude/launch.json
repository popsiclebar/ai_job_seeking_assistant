{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "zsh",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "zsh",
      "runtimeArgs": ["-c", "cd frontend && pnpm dev"],
      "port": 3000
    }
  ]
}
